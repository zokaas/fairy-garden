# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# service_role-avain: vain palvelimelle, älä koskaan julkaise selaimeen
SUPABASE_SERVICE_ROLE_KEY=
# Sovelluksen osoite (näytetään oikotie-ohjeessa)
NEXT_PUBLIC_SITE_URL=https://fairy-garden.vercel.app
# Valinnainen: jaettu iCloud-linkki valmiiseen oikotiehen (Komennot → oikotie → Jaa → Kopioi iCloud-linkki)
NEXT_PUBLIC_SHORTCUT_INSTALL_URL=

# Push-ilmoitukset: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sinun@sahkoposti.fi
# Ajastetun muistutuksen salaisuus (Vercel lisää sen Authorization-otsikkoon)
CRON_SECRET=
